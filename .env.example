############################
# Exemple de configuration #
############################

# IRONCRYPT_PORT=8080
# IRONCRYPT_METRICS_ENABLED=true
# IRONCRYPT_METRICS_PORT=9000
# IRONCRYPT_METRICS_BIND=127.0.0.1

# Chemin du TOML (sinon --config)
# IRONCRYPT_CONFIG_FILE=./ironcrypt.toml

# --- CryptoProvider (selon [crypto_provider] dans le TOML) ---
# AWS KMS : credentials via IAM role / instance profile / IRSA (pas de clés ici)
# AWS_REGION=eu-west-1
# AWS_DEFAULT_REGION=eu-west-1

# Vault Transit : AppRole / K8s (préféré) ou token court
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_K8S_ROLE=ironcrypt
# VAULT_ADDR=https://vault.internal:8200

# HSM PKCS#11 : si crypto_provider.hsm.pin est absent
# IRONCRYPT_HSM_PIN=1234

# Passphrase clé privée locale (éviter --passphrase : visible dans `ps`)
# Ordre: ENV → FILE → FD → STDIN=1 → --passphrase → prompt TTY (CLI)
# IRONCRYPT_PASSPHRASE=
# IRONCRYPT_PASSPHRASE_FILE=/run/secrets/ironcrypt_passphrase
# IRONCRYPT_PASSPHRASE_FD=3
# IRONCRYPT_PASSPHRASE_STDIN=1

# Best-effort mlock des DEK (Unix). Feature `mlock` activée via `payment` ;
# forcer on/off sans rebuild :
# IRONCRYPT_MLOCK=1
# IRONCRYPT_MLOCK=0

# HMAC de signature des journaux d'audit (signing_mode = hmac-env)
# IRONCRYPT_AUDIT_HMAC_KEY=

# Catalog API keys pour ironcryptd
# IRONCRYPT_API_KEYS_BACKEND=file
# IRONCRYPT_API_KEYS_FILE=./keys.json
# Alternative prod (pas de fichier sur disque) : JSON array injecté
# IRONCRYPT_API_KEYS_BACKEND=env
# IRONCRYPT_API_KEYS_JSON=[{"description":"…","keyHash":"…","permissions":["read","write"]}]
# Rechargement sans restart : SIGHUP ou
# IRONCRYPT_API_KEYS_RELOAD_POLL_SECS=30

# Rate limiting (memory = local; redis = multi-replica, needs feature redis-rate-limit)
# IRONCRYPT_RATE_LIMIT_PER_SEC=20
# IRONCRYPT_RATE_LIMIT_BURST=40
# IRONCRYPT_RATE_LIMIT_BACKEND=memory
# IRONCRYPT_RATE_LIMIT_BACKEND=redis
# IRONCRYPT_REDIS_URL=redis://127.0.0.1:6379/

